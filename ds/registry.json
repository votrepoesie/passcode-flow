    {
      "name": "field",
      "type": "registry:ui",
      "title": "Field",
      "description": "The engine behind the primitives' built-in error handling \u2014 the label-line layout (error takes the hint's place in the label row, label turns red, nothing below moves) plus a context that wires id / aria-invalid / aria-describedby. You rarely use it directly: pass label / error to Input, Textarea, SelectTrigger or Search instead. Use <Field> to wrap a custom control. Uses --destructive-text from ds-theme.",
      "dependencies": [
        "motion"
      ],
      "registryDependencies": [
        "https://design-system.example.com/r/utils.json",
        "https://design-system.example.com/r/ds-theme.json"
