{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "ds",
  "homepage": "https://design-system.example.com",
  "items": [
    {
      "name": "ds-tokens",
      "type": "registry:file",
      "title": "Tokens",
      "description": "Raw brand design tokens (colors, type, spacing, radius) as CSS custom properties.",
      "files": [
        {
          "path": "app/ds-tokens.css",
          "type": "registry:file",
          "target": "app/ds-tokens.css"
        }
      ]
    },
    {
      "name": "ds-theme",
      "type": "registry:theme",
      "title": "Theme",
      "description": "Shadcn semantic vars mapped onto tokens, scoped to .ds with a .dark variant. Import after `@import \"tailwindcss\"`. Requires the Geist and Geist Mono font faces loaded by your app.",
      "registryDependencies": [
        "https://design-system.example.com/r/ds-tokens.json"
      ],
      "files": [
        {
          "path": "app/ds-theme.css",
          "type": "registry:file",
          "target": "app/ds-theme.css"
        }
      ]
    },
